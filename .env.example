# Free key from https://aistudio.google.com/apikey — enables AI interviewer, live market research and deep evaluation.
# Without it the app still works in offline mode (built-in question bank + keyword scoring).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres for user accounts + saved interviews (Neon via Vercel Storage injects this automatically).
# For local testing you can use a local Postgres, e.g. postgres://postgres@localhost:5432/postgres
DATABASE_URL=
